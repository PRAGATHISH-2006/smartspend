{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/send-reminder?slot=morning",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/send-reminder?slot=cycle_check",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/send-reminder?slot=evening",
      "schedule": "30 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

